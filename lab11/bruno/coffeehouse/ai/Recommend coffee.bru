meta {
  name: Recommend coffee
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/ai/recommend
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "taste": "sweet",
    "milk": "with_milk",
    "strength": "medium"
  }
}

assert {
  res.status: eq 200
}

settings {
  encodeUrl: true
}
